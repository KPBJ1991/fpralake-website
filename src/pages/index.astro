---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventCard from '../components/EventCard.astro';
import { site, fpra } from '../data/site';
import { splitEvents } from '../data/events';
import { chapterBenefits } from '../data/membership';

const { upcoming } = splitEvents();
const nextThree = upcoming.slice(0, 3);
---

<BaseLayout title={site.name} description={site.description}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy">
    <div
      class="pointer-events-none absolute -top-32 -right-32 size-[36rem] rounded-full bg-royal/60 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="shell relative py-20 sm:py-28">
      <p class="text-xs font-bold tracking-[0.18em] text-gold uppercase">
        Lake County, Florida
      </p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-6xl">
        Advancing the practice of public relations in Lake County.
      </h1>
      <!-- The Association's official tagline, set in the Times New Roman accent
           face that the style guide permits (p.9). Quoted verbatim. -->
      <p class="accent mt-5 text-xl text-gold sm:text-2xl">{site.tagline}</p>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-silver">
        The {site.chapterName} of the {site.parentOrg} is where communicators in
        and around Lake County build their skills, grow their networks, and
        raise the standard of the profession close to home.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a
          href={fpra.joinUs}
          target="_blank"
          rel="noopener"
          class="rounded-brand bg-gold px-6 py-3.5 font-bold text-navy transition-colors hover:bg-gold-light"
        >
          Join FPRA
        </a>
        <a
          href="/events"
          class="rounded-brand border border-silver px-6 py-3.5 font-bold text-white transition-colors hover:bg-royal"
        >
          See upcoming events
        </a>
      </div>
      <p class="mt-8 text-sm text-silver">
        A chapter of the {site.parentOrg} &mdash;
        <a
          href={fpra.home}
          target="_blank"
          rel="noopener"
          class="font-semibold text-white underline underline-offset-4 hover:text-gold"
        >
          fpra.org
        </a>
      </p>
    </div>
  </section>

  <!-- Why the chapter -->
  <section class="shell py-20 sm:py-24">
    <SectionHeading
      eyebrow="Why the Lake County Chapter"
      title="Statewide standards, local relationships."
      lead="FPRA membership connects you to more than 1,000 communications professionals across Florida. The Lake County Chapter is how that connection shows up in your week."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {chapterBenefits.map((benefit) => (
        <div class="rounded-brand border border-rule bg-white p-7">
          <h3 class="text-xl font-bold">{benefit.title}</h3>
          <p class="mt-3 leading-relaxed text-royal">{benefit.description}</p>
        </div>
      ))}
    </div>
    <a
      href="/about"
      class="mt-10 inline-flex items-center gap-1.5 font-bold text-navy underline-offset-4 hover:text-royal hover:underline"
    >
      More about the chapter <span aria-hidden="true">→</span>
    </a>
  </section>

  <!-- Upcoming events -->
  <section class="border-y border-rule bg-sky-tint py-20 sm:py-24">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading
          eyebrow="Calendar"
          title="What's coming up"
          lead="Chapter programs are open to members and guests. Newcomers are welcome at any meeting."
        />
        <a
          href="/events"
          class="font-bold text-navy underline-offset-4 hover:text-royal hover:underline"
        >
          All events →
        </a>
      </div>

      {nextThree.length > 0 ? (
        <div class="mt-12 grid gap-5">
          {nextThree.map((event) => <EventCard event={event} />)}
        </div>
      ) : (
        <p class="mt-12 rounded-brand border border-rule bg-white p-8 text-royal">
          No events are on the calendar right now. Check the
          <a href="/events" class="font-semibold text-navy underline underline-offset-4">
            events page
          </a>
          for past programs, or
          <a href="/contact" class="font-semibold text-navy underline underline-offset-4">
            get in touch
          </a>
          to hear when the next one is announced.
        </p>
      )}
    </div>
  </section>

  <!-- Join CTA -->
  <section class="shell py-20 sm:py-24">
    <div class="rounded-brand bg-navy px-8 py-14 sm:px-14">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Ready to join?
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-silver">
          Membership is held with the state association and includes your local
          chapter affiliation. Applications, membership categories, and current
          dues are all handled at fpra.org.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a
            href={fpra.joinUs}
            target="_blank"
            rel="noopener"
            class="rounded-brand bg-gold px-6 py-3.5 font-bold text-navy transition-colors hover:bg-gold-light"
          >
            Join Us at fpra.org
          </a>
          <a
            href="/membership"
            class="rounded-brand border border-silver px-6 py-3.5 font-bold text-white transition-colors hover:bg-royal"
          >
            See member benefits
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
