---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { fpra, contact } from '../data/site';
import { stateBenefits, chapterBenefits } from '../data/membership';
import { withBase } from '../lib/url';

const steps = [
  {
    title: 'Apply through FPRA',
    body:
      'Membership is held with the state association. Start at the Join Us ' +
      'page, choose the category that fits your role, and select the Lake ' +
      'Chapter as your local chapter.',
    href: fpra.joinUs,
    linkLabel: 'Go to Join Us',
  },
  {
    title: 'Check the categories and dues',
    body:
      'FPRA offers several membership categories, including options for ' +
      'students and retirees. Current categories and dues are maintained by ' +
      'the state office.',
    href: fpra.membershipTypes,
    linkLabel: 'Membership types',
  },
  {
    title: 'Come to a meeting',
    body:
      'You do not have to wait for your application to process. Chapter ' +
      'programs are open to guests, and visiting first is the best way to ' +
      'decide.',
    href: '/events',
    linkLabel: 'See upcoming events',
  },
];
---

<BaseLayout
  title="Membership"
  description="Member benefits of the FPRA Lake County Chapter and the Florida Public Relations Association, plus how to join or renew."
>
  <PageHeader
    eyebrow="Membership"
    title="Join the Lake County Chapter"
    lead="One membership, two levels of value: the resources of a statewide association and a professional community you can reach in fifteen minutes."
  />

  <!-- Primary CTAs -->
  <section class="shell py-16">
    <div class="flex flex-col gap-4 rounded-brand border border-rule bg-sky-tint p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10">
      <div>
        <h2 class="text-2xl font-bold">Join or renew</h2>
        <p class="mt-2 text-royal">
          Both are handled by the state association at fpra.org.
        </p>
      </div>
      <div class="flex flex-wrap gap-4">
        <a
          href={fpra.joinUs}
          target="_blank"
          rel="noopener"
          class="rounded-brand bg-gold px-6 py-3.5 font-bold text-navy transition-colors hover:bg-gold-light"
        >
          Join
        </a>
        <a
          href={fpra.joinUs}
          target="_blank"
          rel="noopener"
          class="rounded-brand border border-rule bg-white px-6 py-3.5 font-bold text-navy transition-colors hover:bg-sky-tint"
        >
          Renew
        </a>
      </div>
    </div>
  </section>

  <!-- Statewide benefits -->
  <section class="shell pb-20 sm:pb-24">
    <SectionHeading
      eyebrow="Statewide"
      title="What FPRA membership includes"
      lead="Every chapter member is a member of the Florida Public Relations Association and receives the full slate of statewide benefits."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {stateBenefits.map((benefit) => (
        <div class="rounded-brand border border-rule bg-white p-7">
          <h3 class="text-lg font-bold">{benefit.title}</h3>
          <p class="mt-3 leading-relaxed text-royal">{benefit.description}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-sm text-royal">
      Benefits summarized from
      <a
        href={fpra.joinUs}
        target="_blank"
        rel="noopener"
        class="font-semibold text-navy underline underline-offset-4 hover:text-royal"
      >
        fpra.org/join-us
      </a>. Refer to the state association for the authoritative list.
    </p>
  </section>

  <!-- Chapter benefits -->
  <section class="border-y border-rule bg-sky-tint py-20 sm:py-24">
    <div class="shell">
      <SectionHeading
        eyebrow="Locally"
        title="What the Lake County Chapter adds"
        lead="The part of membership you feel every month."
      />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {chapterBenefits.map((benefit) => (
          <div class="rounded-brand border border-rule bg-white p-7">
            <h3 class="text-lg font-bold">{benefit.title}</h3>
            <p class="mt-3 leading-relaxed text-royal">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How to join -->
  <section class="shell py-20 sm:py-24">
    <SectionHeading eyebrow="Getting started" title="How to join" />
    <ol class="mt-12 grid gap-6 lg:grid-cols-3">
      {steps.map((step, i) => {
        const external = step.href.startsWith('http');
        // Internal steps need the base prefix; external links are left alone.
        const href = external ? step.href : withBase(step.href);
        return (
          <li class="flex flex-col rounded-brand border border-rule bg-white p-7">
            <span
              class="flex size-9 items-center justify-center rounded-full bg-navy text-sm font-bold text-white"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="mt-5 text-xl font-bold">{step.title}</h3>
            <p class="mt-3 grow leading-relaxed text-royal">{step.body}</p>
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener' : undefined}
              class="mt-5 inline-flex items-center gap-1.5 font-bold text-navy underline-offset-4 hover:text-royal hover:underline"
            >
              {step.linkLabel} <span aria-hidden="true">→</span>
            </a>
          </li>
        );
      })}
    </ol>

    <div class="mt-12 rounded-brand border border-rule bg-sky-tint p-8">
      <h3 class="text-lg font-bold">Questions before you join?</h3>
      <p class="mt-3 leading-relaxed text-royal">
        The state association keeps a membership FAQ, and the chapter's
        membership team is happy to talk through which category fits your role.
      </p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
        <a
          href={fpra.faqs}
          target="_blank"
          rel="noopener"
          class="font-bold text-navy underline underline-offset-4 hover:text-royal"
        >
          FPRA membership FAQs →
        </a>
        {contact.email && (
          <a
            href={`mailto:${contact.email}?subject=Membership%20question`}
            class="font-bold text-navy underline underline-offset-4 hover:text-royal"
          >
            Email the chapter →
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
