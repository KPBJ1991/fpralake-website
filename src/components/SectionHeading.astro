---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, lead, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && (
    <p class="text-xs font-bold tracking-[0.18em] text-royal uppercase">{eyebrow}</p>
  )}
  <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {lead && <p class="mt-4 text-lg leading-relaxed text-royal">{lead}</p>}
</div>
